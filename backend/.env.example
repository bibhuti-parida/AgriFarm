# --- Server Environment ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL Database (Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrifarm?schema=public

# --- Authentication ---
# Secure random string (min 32 chars)
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_agrifarm_app
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- External Integrations ---
# Weather API (OpenWeatherMap optional key; Open-Meteo fallback is built-in)
WEATHER_API_KEY=

# Agricultural Market Price API (e.g. data.gov.in / Agmarknet API key)
MARKET_DATA_API_KEY=

# --- Development Seed Credential ---
SEED_DEMO_PASSWORD=AgriFarmPassword123

